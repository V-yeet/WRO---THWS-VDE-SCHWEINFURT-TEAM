/*Unser Programm steuert einen autonomen Roboter auf Basis eines ESP32, 
der Ultraschallsensoren und eine Pixy-Kamera verwendet, 
um einer Strecke zu folgen und farbige Blöcke zu erkennen. 
Der Roboter kommuniziert mit einem Arduino Nano, um den Yaw-Winkel und Kameradaten zu erhalten, 
wodurch er seine Richtung halten und die Runden zählen kann. 
Ein PD-Regler passt die Lenkung mithilfe der Wandabstände und der Richtungsabweichung an, 
um eine stabile Fahrt zu gewährleisten. Der Roboter vermeidet Hindernisse, 
folgt farbigen Blöcken oder umfährt sie, erkennt Kurven automatisch und stoppt nach etwa drei gefahrenen Runde*/


#include <ESP32Servo.h>
#include <Wire.h>
#include <math.h>
#define trigLL 12
#define echoLL 5
#define trigRR 18
#define echoRR 19
#define trigF 26
#define echoF 27
#define t1 32
#define t2 33
#define Spd 13
#define servoPin 25
#define RXD2 16
#define TXD2 17
//Global Variables//
HardwareSerial mySerial(2);
float Yaw; // Angle of the robot(Information comming form Arduino Nano on UART transmission).
float trigger = 0.0; //Trigger from Nano that all values are coming and the robot is good to go.
float Kp = 5.0;
float Kd = 5.0;
int followpath = 0; //Global variable for the robot to get the trigger to go after a blok detection.
bool reddet = false; //Red Block detection boolean.
bool greendet = false; //Green Block detection boolean.
float headingError = 0.0; //Varialbe for the error between the intented heading angle and actual heading angle.
float headingCorrection = 0; //Variable which corrected headingError.
float targetHeading = 0; //Variable used for intented heading angle.
bool raceEnd = false; //Boolean used for Race ending logic.
float yawstart = 0; //Variable used to calculate the turning angle for the robot to turn.
unsigned long nachredon = 0; //Variable used to add a delay after the red block detection. 
unsigned long nachgreenon = 0; //Variable used to add a delay after the green block detection.
float Speed; //no use(gives wrong speed values.)
float stopdistance; //Variable used as a memory for to robot to know where it has to stop.
float Yawsee = 0.0; //Variable used as a memory for the detecting the stop point after 3 laps.

// Coordinated of color detections on pixy(Transmitting through arduino nano).
int X1, X2, X3; 
int Y1, Y2, Y3;
int S1, S2, S3;

int turnState = 0; //Variable used to start/stop turning and give information of where to turn.
int Brainlatch = 0; //Variable used as a latch for the robot to know in what directions is it moving.
bool frontdetect = false; //Variable used for front distance true and false detection.

//Color detection booleans.
bool orange = false; 
bool blue = false;
bool red = false;
bool green = false;
bool magenta = false;
bool wall = false;
bool nachgreen = false;
bool nachred = false;

//Robot movement Variables
Servo steering;
int SPD = 70;
int Min = 0;
int Mid = 108;
int Max = 180;

//PD stearing variables
float error = 0;
float preverror = 0;
float integral = 0;
float derivative = 0;
float correction = 0;

//Setting up INPUTS/OUTPUTS of esp pins.
void setup() {
  Serial.begin(115200);

  pinMode(t1, OUTPUT);
  pinMode(t2, OUTPUT);
  pinMode(Spd, OUTPUT);

  pinMode(trigF, OUTPUT);
  pinMode(echoF, INPUT);
  pinMode(trigRR, OUTPUT);
  pinMode(echoRR, INPUT);
  pinMode(trigLL, OUTPUT);
  pinMode(echoLL, INPUT);

  steering.attach(servoPin, 1000, 2000);

  mySerial.begin(115200, SERIAL_8N1, RXD2, TXD2);

  delay(1000);
  Serial.println("Ready");

  targetHeading = 0;
}

// UART READ
void updateNanoData() {
  static uint8_t buffer[18];

  while (mySerial.available() >= 18) {
    if (mySerial.read() == 0xAA) {
      if (mySerial.read() == 0xBB) {
        mySerial.readBytes(buffer, 18);

        X1 = buffer[0]; Y1 = buffer[1]; S1 = buffer[2];
        X2 = buffer[3]; Y2 = buffer[4]; S2 = buffer[5];
        X3 = buffer[6]; Y3 = buffer[7]; S3 = buffer[8];

        trigger = buffer[9];

        memcpy(&Yaw, &buffer[10], 4);
        memcpy(&Speed, &buffer[14], 4);

        return;
      }
    }
  }
}

//SENSOR FUNCTIONS (Distance detection each set at 15000microsecons to get distance upto 255cm)
float distanceF() {
  digitalWrite(trigF, LOW);
  delayMicroseconds(2);
  digitalWrite(trigF, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigF, LOW);

  long duration = pulseIn(echoF, HIGH, 15000);
  float distance = duration * 0.034 / 2;

  if (distance == 0) distance = 999;
  return distance;
}

float distanceLL() {
  digitalWrite(trigLL, LOW);
  delayMicroseconds(2);
  digitalWrite(trigLL, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigLL, LOW);

  long duration = pulseIn(echoLL, HIGH, 15000);
  float distance = duration * 0.034 / 2;

  if (distance == 0) distance = 999;
  return distance;
}
float distanceRR() {
  digitalWrite(trigRR, LOW);
  delayMicroseconds(2);
  digitalWrite(trigRR, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigRR, LOW);

  long duration = pulseIn(echoRR, HIGH, 15000);
  float distance = duration * 0.034 / 2;

  if (distance == 0) distance = 999;
  return distance;
}
//ROBOT MOVEMENT BASICS FUNCTIONS
void setSpeed(int s) {
  int pwm = map(s, 0, 100, 0, 255);
  analogWrite(Spd, pwm);
}
void driveForward(int s) {
  digitalWrite(t1, HIGH);
  digitalWrite(t2, LOW);
  setSpeed(s);
}
void driveBackward(int s) {
  digitalWrite(t1, LOW);
  digitalWrite(t2, HIGH);
  setSpeed(s);
}
void stop(int s) {
  digitalWrite(t1, LOW);
  digitalWrite(t2, LOW);
  setSpeed(s);
}

// COLOR DETECTION(SENSING & LOGIC)
void colordetector() {
  updateNanoData();
  int blockh = 40;
  int yh = 140;
  int wallh = 140;
  int yb = 100;
  int xh = 140;
  int xb = 160;
  orange = ((S1 == 3 && Y1 >= yb && Y1 < yh) ||
            (S2 == 3 && Y2 >= yb && Y2 < yh) ||
            (S3 == 3 && Y3 >= yb && Y3 < yh));

  blue = ((S1 == 2 && Y1 >= yb && Y1 < yh) ||
          (S2 == 2 && Y2 >= yb && Y2 < yh) ||
          (S3 == 2 && Y3 >= yb && Y3 < yh));

  wall = ((S1 == 7 && Y1 >= wallh) ||
          (S2 == 7 && Y2 >= wallh) ||
          (S3 == 7 && Y3 >= wallh));

  red = ((S1 == 1 && Y1 >= blockh && Y1 < yb) ||
         (S2 == 1 && Y2 >= blockh && Y2 < yb) ||
         (S3 == 1 && Y3 >= blockh && Y3 < yb));

  nachred = ((S1 == 1 && Y1 >= yb) ||
             (S2 == 1 && Y2 >= yb) ||
             (S3 == 1 && Y3 >= yb));

  green = ((S1 == 4 && Y1 >= blockh && Y1 < yb) ||
           (S2 == 4 && Y2 >= blockh && Y2 < yb) ||
           (S3 == 4 && Y3 >= blockh && Y3 < yb));

  nachgreen = ((S1 == 4 && Y1 >= yb) ||
               (S2 == 4 && Y2 >= yb) ||
               (S3 == 4 && Y3 >= yb));

  magenta = ((S1 == 5 && Y1 >= blockh) ||
             (S2 == 5 && Y2 >= blockh) ||
             (S3 == 5 && Y3 >= blockh));
  if (nachred) {
    nachredon = millis();
  } else if (millis() - nachredon >= 200) {
    nachred = false;
  }

  if (nachgreen) {
    nachgreenon = millis();
  } else if (millis() - nachgreenon >= 200) {
    nachgreen = false;
  }
}
//MAIN LOOP
void loop() {
  //GETTING REQUIRED DATA FROM FUNCTIONS AND ASSIGNING SOME GLOBAL VARIABLES
  updateNanoData();
  float distF = distanceF();   delay(10);
  float distLL = distanceLL(); delay(10);
  float distRR = distanceRR();
  colordetector();
  Yawsee = Yaw;
  //WORKING LOGIC
  if (trigger == 0.0) { //1. TRIGGER SECTION
    stop(0);
    Serial.println("Calibrating.....");
    stopdistance = distF;
  } else {
    if (abs(Yawsee) <= 1040.0) {  //2. FINSIHING SECTION
      if (distF <= 7.5 ) {   //3. FRONT HITTING SECTION
        frontdetect = true;
      } else if (distF > 15.0 ) {
        frontdetect = false;
      }

      if (frontdetect) {   
        steering.write(Mid);
        driveBackward(SPD);
      } 
      else {
        if (red) {    //4. COLOR BLOCK DETECTION SECTION
          reddet = true;
        } else if (green) {
          greendet = true;
        } else {
          reddet = false;
          greendet = false;
        }

        if (Brainlatch == 0) {     //5. DIRECTION SECTION
          if (distRR > distLL && Brainlatch != 2) {
            Brainlatch = 1;
          } else if (distLL > distRR && Brainlatch != 1) {
            Brainlatch = 2;
          }
        }

        if (reddet) {    //6. COLOR BLOCK CHASING SECTION
          if (S1 == 1) {
            int median = 175 - X1;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          } else if (S2 == 1) {
            int median = 175 - X2;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          } else if (S3 == 1) {
            int median = 175 - X3;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          }
        }

        if (greendet) {
          if (S1 == 4) {
            int median = 175 - X1;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          } else if (S2 == 4) {
            int median = 175 - X2;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          } else if (S3 == 4) {
            int median = 175 - X3;
            int steer = Mid - median;
            steer = constrain(steer, Min, Max);
            steering.write(steer);
          }
        }

        if (turnState == 0 && !reddet && !greendet) {    //7. COLOR BLOCK AVOIDANCE SECTION
          if (nachred) {
            followpath = 1;
            
          } else if (nachgreen) {
            followpath = 2;
            
          }
          else{
            followpath = 0;
          }
          if(followpath == 1){
            if (Brainlatch == 1) {
              error = distRR - 25.0;
            } else if (Brainlatch == 2) {
              error = 25.0 - distRR;
            }
          }
          else if(followpath == 2){ 
            if (Brainlatch == 1) {
              error = 25.0 - distLL;
            } else if (Brainlatch == 2) {
              error = distLL - 25.0;
            }
          }
          else{
            if(Brainlatch == 1){
            error = distRR - distLL;
            }
            else if(Brainlatch == 2){
              error = distLL - distRR;
            }
          }
          derivative = error - preverror;    //8. PD STEARING SECTION
          correction = Kp * error + + Kd * derivative;
          preverror = error;
          float difference = Yaw/90;
          if(difference - floor(difference) <= 0.25 || difference - floor(difference) >= 0.75 ){    //9. HEADING ANGLE SNAPPING SECTION
            targetHeading = round(Yaw/90) * 90; 
          }
          headingError = Yaw - targetHeading;
          headingError = constrain(headingError, -90, 90);
          if(Brainlatch == 1){         //10. STEARING MODES SECTON
          headingCorrection = Mid + headingError;
          }
          else if(Brainlatch == 2){
            headingCorrection = Mid - headingError;
          }
          int steeringangle = Mid;
          if (Brainlatch == 1) {
            steeringangle = Mid + correction;
            /*if(abs(headingError) >= 30.0){
            steeringangle = headingCorrection * 0.2 + steeringangle * 0.8;
          }
           else if (abs(headingError) >= 45.0) {
            steeringangle = headingCorrection * 0.7 + steeringangle * 0.3;
          } else if (abs(headingError) >= 60.0) {
            steeringangle = headingCorrection * 1.5; 
          }
          } else if (Brainlatch == 2) {
            steeringangle = Mid - correction;
            if(abs(headingError) >= 30.0){
            steeringangle = headingCorrection * 0.2 + steeringangle * 0.8;
          }
           else if (abs(headingError) >= 45.0) {
            steeringangle = headingCorrection * 0.7 + steeringangle * 0.3;
          } else if (abs(headingError) >= 60.0) {
            steeringangle = headingCorrection * 1.5; 
          }*/
          } 
          steeringangle = constrain(steeringangle, Min, Max);
          steering.write(steeringangle);
          driveForward(SPD);
          if (distF <= 60.0 && distRR > 100.0 && distLL <= 100.0) {   //11. TURNING LOGIC SECTION
            yawstart = Yaw;
            turnState = 1;
          } else if (distF <= 60.0 && distLL > 100.0 && distRR <= 100.0) {
            yawstart = Yaw;
            turnState = 2;
          }
        }
        if (turnState == 1) {    //12. TURNING STATES SECTION
          steering.write(Max);
          driveForward(SPD);
          if (abs(Yaw - yawstart) >= 80.0) {
            turnState = 0;
            }
        } else if (turnState == 2) {
          steering.write(Min);
          driveForward(SPD);
          if (abs(Yaw - yawstart) >= 80.0) {
            turnState = 0;
          }
        }
      }
    } else {     //13. RACE ENDING SECTION
      if (!raceEnd) {
        raceEnd = true;
      }

      steering.write(Mid);

      if (distF >= stopdistance) {
        driveForward(SPD);
      } else {
        stop(0);
      }
    }
  }
  //PRINTING DATA TO STUDY THE VALUES
  Serial.print("Brainlatch: "); Serial.print(Brainlatch);
  Serial.print(" | turnState: "); Serial.print(turnState);

  Serial.print(" | Speed: "); Serial.print(Speed);
  Serial.print(" | Distfront: "); Serial.print(distF);
  Serial.print(" | DistLL: "); Serial.print(distLL);
  Serial.print(" | DistRR: "); Serial.print(distRR);

  Serial.print(" | Yaw: "); Serial.print(Yaw);
  Serial.print(" | Error: "); Serial.print(error);
  Serial.print(" | Correction: "); Serial.print(correction);
  Serial.print(" | TargetHeading: "); Serial.print(targetHeading);
  Serial.print(" | HeadingCorr: "); Serial.print(headingCorrection);

  Serial.print(" | X1: "); Serial.print(X1);
  Serial.print(" | Y1: "); Serial.print(Y1);
  Serial.print(" | S1: "); Serial.print(S1);

  Serial.print(" | X2: "); Serial.print(X2);
  Serial.print(" | Y2: "); Serial.print(Y2);
  Serial.print(" | S2: "); Serial.print(S2);

  Serial.print(" | X3: "); Serial.print(X3);
  Serial.print(" | Y3: "); Serial.print(Y3);
  Serial.print(" | S3: "); Serial.print(S3);

  Serial.println();
}
